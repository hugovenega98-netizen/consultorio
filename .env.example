# LOCAL con Docker:
DATABASE_URL="postgresql://consultorio:consultorio@localhost:5432/consultorio?schema=public"
DIRECT_URL="postgresql://consultorio:consultorio@localhost:5432/consultorio?schema=public"

# VERCEL + NEON:
# DATABASE_URL = cadena POOLED de Neon (host suele contener -pooler)
# DIRECT_URL   = cadena DIRECTA de Neon (sin -pooler), usada por Prisma Migrate
# Ambas deben incluir sslmode=require si Neon las entrega así.
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
